{
  "mcpServers": {
    "constellation": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@constellationdev/mcp@latest"
      ],
      "env_vars": [
        "CONSTELLATION_ACCESS_KEY",
        "CONSTELLATION_AUGMENT_SEARCH",
        "CONSTELLATION_IMPACT_NOTICE"
      ]
    }
  }
}
