{
  "description": "Constellation code intelligence hooks inject code_intel MCP awareness into sessions and tool selection",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/inject.js",
            "statusMessage": "Loading Constellation guidance...",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/inject.js",
            "statusMessage": "Loading Constellation guidance...",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/bash.js",
            "statusMessage": "Consulting Constellation...",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__constellation__code_intel",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/code-intel.js",
            "statusMessage": "Recording Constellation use...",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
